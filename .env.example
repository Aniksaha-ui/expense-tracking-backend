APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
JWT_SECRET=
JWT_TTL=1440
JWT_ISSUER="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

EXPENSE_REPORT_ENABLED=true
EXPENSE_REPORT_SEND_TIME=08:00
EXPENSE_REPORT_TIMEZONE=Asia/Dhaka
EXPENSE_REPORT_SKIP_EMPTY=true
EXPENSE_REPORT_RECIPIENT=
EXPENSE_REPORT_CC=
EXPENSE_REPORT_BCC=

COST_REPORT_ENABLED=true
COST_REPORT_SEND_TIME=08:30
COST_REPORT_TIMEZONE=Asia/Dhaka
COST_REPORT_SKIP_EMPTY=true
COST_REPORT_RECIPIENT=
COST_REPORT_CC=
COST_REPORT_BCC=
COST_REPORT_TOP_CATEGORIES=10
COST_REPORT_MAX_SAVINGS_RATE=0.30

EXPENSE_INTELLIGENCE_REPORT_ENABLED=true
EXPENSE_INTELLIGENCE_REPORT_TIMEZONE=Asia/Dhaka
EXPENSE_INTELLIGENCE_DAILY_SEND_TIME=21:00
EXPENSE_INTELLIGENCE_WEEKLY_SEND_TIME=21:30
EXPENSE_INTELLIGENCE_WEEKLY_SEND_DAY=sunday
EXPENSE_INTELLIGENCE_BI_WEEKLY_SEND_TIME=21:45
EXPENSE_INTELLIGENCE_BI_WEEKLY_SEND_DAY=sunday
EXPENSE_INTELLIGENCE_MONTHLY_SEND_TIME=22:00
EXPENSE_INTELLIGENCE_MONTHLY_SEND_DAY=1
EXPENSE_INTELLIGENCE_SKIP_EMPTY=true
EXPENSE_INTELLIGENCE_RECIPIENT=
EXPENSE_INTELLIGENCE_CC=
EXPENSE_INTELLIGENCE_BCC=
EXPENSE_INTELLIGENCE_LOOKBACK_MONTHS=12
EXPENSE_INTELLIGENCE_EXCLUDED_MONTHS=
EXPENSE_INTELLIGENCE_TOP_CATEGORIES=10
EXPENSE_INTELLIGENCE_SMALL_TRANSACTION_THRESHOLD=500.00
EXPENSE_INTELLIGENCE_SIGNIFICANT_CHANGE_PERCENTAGE=20.0
EXPENSE_INTELLIGENCE_ANOMALY_MULTIPLIER=2.50
EXPENSE_INTELLIGENCE_MINIMUM_ANOMALY_SAMPLES=5
EXPENSE_INTELLIGENCE_MAX_SAVINGS_RATE=0.30

DOMPDF_PAPER=a4
DOMPDF_ORIENTATION=portrait
DOMPDF_DEFAULT_FONT=Helvetica

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
